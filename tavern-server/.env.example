# 复制为 .env 或直接导出为环境变量。生产环境必须改 TAVERN_TOKEN_PEPPER。

# 监听（生产建议只绑 127.0.0.1，由 Caddy/Nginx 反代并终止 HTTPS）
TAVERN_HOST=127.0.0.1
TAVERN_PORT=9878

# 数据库文件
TAVERN_DB=./data/tavern.db

# 令牌哈希胡椒 —— 泄露等于所有令牌可被离线爆破，务必改为长随机串并妥善保管
TAVERN_TOKEN_PEPPER=dev-pepper-CHANGE-ME

# 会话有效期（天）
TAVERN_SESSION_TTL_DAYS=30

# 种子脚本读取既有数据的位置（默认取上一级目录，即仓库根）
TAVERN_REPO_ROOT=..
