{
  "name": "tavern-server",
  "version": "0.1.0",
  "private": true,
  "description": "酒馆看板后端（原型）：仓库即真相的备份源 + 投稿/审核 API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "bootstrap": "node --disable-warning=ExperimentalWarning scripts/bootstrap.mjs",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.mjs",
    "reset": "node --disable-warning=ExperimentalWarning scripts/reset.mjs",
    "snapshot": "node --disable-warning=ExperimentalWarning scripts/snapshot.mjs",
    "snapshot:check": "node --disable-warning=ExperimentalWarning scripts/snapshot.mjs --check",
    "pack": "node --disable-warning=ExperimentalWarning scripts/tavern-pack.mjs",
    "unpack": "node --disable-warning=ExperimentalWarning scripts/tavern-unpack.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "e2e": "node --disable-warning=ExperimentalWarning tests/e2e/run.mjs",
    "e2e:browser": "node --disable-warning=ExperimentalWarning tests/e2e/run.mjs --browser",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.mjs",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.mjs",
    "seed:cases": "node --disable-warning=ExperimentalWarning scripts/seed-cases.mjs"
  },
  "dependencies": {}
}
